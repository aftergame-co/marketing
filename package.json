{
  "name": "aftergame-marketing",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start:dev": "next dev",
    "build": "next build && next-image-export-optimizer",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc --noEmit",
    "releases:sync": "node scripts/sync-releases.mts",
    "releases:check": "node scripts/sync-releases.mts --check"
  },
  "browserslist": "defaults, not ie <= 11",
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-image-export-optimizer": "^1.21.2",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-before-after-slider-component": "^1.1.8",
    "react-dom": "^19.3.1",
    "rehype-add-classes": "^1.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-extended-table": "^2.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.5",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^7.0.2"
  }
}
